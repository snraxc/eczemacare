# Copy this file to .env and fill in real values. .env is loaded automatically
# on startup (via python-dotenv) and should NOT be committed to git.
#
# Email is sent via Resend's HTTP API (not raw SMTP) - most cloud hosts,
# including Render's free tier, block outbound SMTP as an anti-spam measure.
# Sign up at resend.com (free), create an API key, and paste it below.
# Without verifying your own domain on Resend, RESEND_FROM_EMAIL must stay
# "onboarding@resend.dev" and you can only send to the address you signed
# up to Resend with.

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FROM_NAME=EczemaCare

# Your best estimate of the real-world fraction of submitted photos that are
# actually eczema (not the 50/50 split in eczema_dataset/val - that's just an
# artificially balanced training/validation set). Used to Bayes-adjust the
# model's probability output in main.py's apply_bayes_prior(). 0.5 = no
# adjustment (assume same balance as the validation set).
ECZEMA_PRIOR=0.5

# Secret key used to sign login tokens (JWT). Generate a random one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value in each environment (local vs Render) - keep it out of git.
SECRET_KEY=replace_with_a_random_generated_secret
