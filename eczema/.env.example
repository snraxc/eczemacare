# Copy this file to .env and fill in real values. .env is loaded automatically
# on startup (via python-dotenv) and should NOT be committed to git.
#
# Any SMTP provider works here (Gmail, Outlook/Hotmail, SendGrid, Mailgun, etc.) -
# whatever account you configure is just the "relay" that sends the email; it can
# deliver to any recipient address (gmail.com, hotmail.com, etc).
#
# Gmail example: turn on 2-Step Verification on the Google account, then create
# an "App Password" (Google Account > Security > App passwords) and use that
# below instead of your normal Gmail password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=EczemaCare

# Your best estimate of the real-world fraction of submitted photos that are
# actually eczema (not the 50/50 split in eczema_dataset/val - that's just an
# artificially balanced training/validation set). Used to Bayes-adjust the
# model's probability output in main.py's apply_bayes_prior(). 0.5 = no
# adjustment (assume same balance as the validation set).
ECZEMA_PRIOR=0.5
